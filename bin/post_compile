#!/bin/bash
set -e

echo "=== Installing system dependencies for GIS packages ==="
apt-get update -qq
apt-get install -y -qq --no-install-recommends \
    libgdal-dev \
    gdal-bin \
    libgeos-dev \
    libproj-dev \
    libspatialindex-dev \
    > /dev/null 2>&1

echo "=== Upgrading pip ==="
pip install --upgrade pip setuptools wheel

echo "=== Installing Python dependencies ==="
pip install -r requirements.txt

echo "=== Build complete ==="
